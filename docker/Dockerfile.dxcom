# DX-COM 컴파일러 이미지 (linux/amd64)
# BASE_IMAGE 로 베이스 이미지를 바꿀 수 있다 (예: python:3.11-slim-bookworm)
#   docker build --platform linux/amd64 -t dxcom:2.5.0 -f docker/Dockerfile.dxcom docker/                                  # dxnn v9
#   docker build --platform linux/amd64 --build-arg DXCOM_VERSION=2.4.1 -t dxcom:2.4.1 -f docker/Dockerfile.dxcom docker/  # dxnn v8
ARG BASE_IMAGE=python:3.11-slim
FROM --platform=linux/amd64 ${BASE_IMAGE}

ARG DXCOM_VERSION=2.5.0

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 make \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir dx-com==${DXCOM_VERSION}

WORKDIR /work
